# =============================================================================
# CONFIGURATION POUR LE DÉPLOIEMENT MONOLITHIQUE SUR RENDER
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

# Environment (production recommandé pour Render)
NODE_ENV=production

# Port de l'application (Render utilise PORT par défaut)
PORT=3000

# Base de données MongoDB
# Sur Render, utilisez MongoDB Atlas ou un service MongoDB externe
DATABASE_URL=mongodb://your-mongodb-url/track-prod

# Secret pour JWT (IMPORTANT: Utiliser une clé sécurisée en production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# URL du frontend (pour CORS et WebSocket)
# En production monolithique, c'est la même URL que l'app
FRONTEND_URL=https://your-app-name.onrender.com

# -----------------------------------------------------------------------------
# Frontend Configuration (Variables VITE_)
# -----------------------------------------------------------------------------

# URL de l'API (en production monolithique, c'est la même URL)
VITE_API_BASE_URL=https://your-app-name.onrender.com

# Cloudinary Configuration pour le stockage des images
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# WebSocket Configuration
VITE_WS_CHANNEL_NAME=users
VITE_WS_HOST=your-app-name.onrender.com
VITE_WS_PORT=443
VITE_WS_PROTOCOL=wss

# Mapbox Token pour les cartes
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-token

# =============================================================================
# NOTES IMPORTANTES
# =============================================================================
#
# 1. Sur Render, configurez ces variables dans l'onglet "Environment" de votre service
# 2. Ne committez JAMAIS de fichier .env avec des valeurs réelles
# 3. FRONTEND_URL doit correspondre à l'URL de votre app Render
# 4. En production, utilisez toujours des clés sécurisées pour SECRET_KEY
# 5. Pour MongoDB, utilisez MongoDB Atlas (gratuit jusqu'à 512MB)
#
